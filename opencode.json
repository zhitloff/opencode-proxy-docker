{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "lmstudio": {
      "name": "LMStudio",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://proxy:1234/v1"
      },
      "models": {
      }
    },
    "mtplx": {
      "name": "MTPLX",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://proxy:8000/v1"
      },
      "models": {
        "mtplx-bonsai-2-27b-optimized-speed": {
          "name": "mtplx-bonsai-2-27b-optimized-speed"
        },
        "mtplx-mimo-v26-qwen-9b-optimized-speed": {
          "name": "mtplx-mimo-v26-qwen-9b-optimized-speed"
        }
      }
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "**/.env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.git/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.*/**",
      "effect": "deny"
    },
    {
      "action": "grep",
      "resource": "**/.git/**",
      "effect": "deny"
    },
    {
      "action": "grep",
      "resource": "**/.*/**",
      "effect": "deny"
    }
  ]
}
